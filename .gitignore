# Rimozione del dataset, sia raw data che processed data
data/s*
rawdata/S*
todo.txt

# Appunti personali, restano solo in locale
mieUtilities/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Dependencies
node_modules/
venv/
env/
__pycache__/
*.pyc

# Build
dist/
build/
*.egg-info/

# Logs
*.log
logs/

# Temp files
*.tmp
*.bak

# Tesi: online c'e' solo la versione consegnata, in tesi/consegna, con i sorgenti completi
# e il pdf. La versione da stampare resta solo in locale perche' contiene i ringraziamenti.
# Serve "tesi/*" e non "tesi/": escludendo la cartella stessa git non guarderebbe dentro
# e la riga di eccezione non avrebbe effetto.
tesi/*
!tesi/consegna/

# File ausiliari di LaTeX, nel caso la versione consegnata venga ricompilata sul posto
tesi/consegna/*.aux
tesi/consegna/*.bbl
tesi/consegna/*.blg
tesi/consegna/*.toc
tesi/consegna/*.lof
tesi/consegna/*.lot
tesi/consegna/*.out
tesi/consegna/*.synctex.gz
tesi/consegna/*.fdb_latexmk
tesi/consegna/*.fls
